{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MableBank.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MableBank.Api/bin/Debug/net10.0/MableBank.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MableBank.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5223"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
